PORT=4000
# Required for POST /api/chat. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Required for POST /api/tts. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash-tts (Aoede voice)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional comma-separated allowlist for a separately hosted frontend.
CLIENT_ORIGINS=
# Used only when running Vite on its own instead of Express's Vite middleware.
API_PROXY_TARGET=http://localhost:4000
